MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.hyzbbi7.mongodb.net/wedrings?appName=Cluster0
# Optional DNS override when the default public resolvers are not reachable.
# MONGODB_DNS_SERVERS=192.168.1.1,192.168.1.2
APP_AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Brevo API is preferred, especially on Vercel.
BREVO_API_KEY=your-brevo-api-key
SENDER_NAME=WedRings
SENDER_EMAIL=your-verified-sender@example.com
# Optional local-only SMTP fallback; Vercel uses the Brevo API instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=your-gmail-address@gmail.com
